# เช็คเวอร์ชัน Docker
docker -v

# รัน Image hello-world (โหลดและรันเทส)
docker run hello-world

# ดู Container ทั้งหมด (รวมที่หยุดทำงานแล้ว)
docker ps -a

# ดู Image ทั้งหมดในเครื่อง
docker images

# รัน Image busybox
docker run busybox

# รัน busybox พร้อมสั่ง ping google.com
docker run busybox ping google.com //ถ้ากด Ctrl+C จะหยุด Container ทันที

# หยุด Container
docker stop <container_id> ex. docker stop a6a3cdaf0b46

# ดึง Image จาก Docker Hub (ยังไม่รัน)
docker pull <image_name> ex. docker pull busybox

# สร้าง Container เตรียมไว้ (ยังไม่รัน)
docker create <image_name>

# สร้าง Container พร้อมคำสั่ง ping (ยังไม่รัน)
docker create busybox ping google.com

# สั่งเริ่มรัน Container ที่สร้างไว้
docker start <container_id> ex . docker start 3c83a9b88e84 (เอาไอดีจากคำสั่ง docker ps -a)

# ลบ Container
docker rm <container_id>

# ล้างขยะ (ลบอมเมจที่มไ่ต้องการอีกต่อไป Container ที่หยุด, Network ไม่ใช้, Cache)
docker system prune

# รัน Nginx (แบบปกติ)
docker run nginx //เช็คด้วยการเปิดอีกเทอมนอลแล้วพิมพ์คำสั่ง docker ps จะเห็น Container รันอยู่

# เข้าไปพิมพ์คำสั่งใน Container (Shell/Bash)
docker exec -it <container_id> sh (มันจะเปลี่ยนเป็น ตัว '#' อยู่ในอีกโลกนึงแล้ว แล้ว พิมพ์คำสั่งได้เลย ex. ls, cd, etc.)
docker exec -it <container_id> bash

pwd //ดูตำแหน่งที่อยู่ใน Container
ls //ดูไฟล์ใน Container
cd usr/share/nginx/html //เปลี่ยนตำแหน่งไปที่โฟลเดอร์ของ Nginx
cat index.html //ดูเนื้อหาไฟล์ index.html

# รัน Nginx เชื่อมพอร์ตเครื่อง 80 เข้าผ่าน browser -> การเข้าถึง Container 80 
docker run -p 80:80 nginx

# รัน Nginx เบื้องหลัง (Background) เชื่อมพอร์ต 9000 -> 80
docker run -d -p 9000:80 nginx // ถ้าใส่ -d จะรันอยู่เบื้องหลัง (Background) 
docker run -p 9000:80 nginx // ถ้าไม่ใส่ -d จะรันอยู่หน้าเทอมนอล (Foreground) ต้องเปิดเทอมนอลเพิ่มอีกอันเพื่อเช็คสถานะ Container ด้วยคำสั่ง docker ps

# ดูรายละเอียดเชิงลึกของ Image  แสดงข้อมูลทั้งหมดของ Image ที่ชื่อ nginx
docker image inspect nginx

# ลบ Image
docker image rm <image_id>

# แสดงรายการ Image (เหมือน docker images)
docker image ls 

# ดึง Image ที่ต้องใช้
docker pull wordpress
docker pull mysql:5.7
docker pull phpmyadmin/phpmyadmin

# สร้าง Network ชื่อ wordpress
docker network create wordpress

# เช็ครายการ Network
docker network ls

# 1. รัน MySQL (กำหนดรหัสผ่านและเชื่อม Network) 
docker run --name mysql --network wordpress -e MYSQL_ROOT_PASSWORD=1111 -e MYSQL_DATABASE=wordpress_db -e MYSQL_USER=wordpress -e MYSQL_PASSWORD=wordpress -d mysql:5.7

//คำอธิบายคำสั่ง --name mysql ตั้งชื่อ Container ว่า mysql --network wordpress เชื่อม Container เข้ากับ Network ที่สร้างไว้ -e MYSQL_ROOT_PASSWORD=1111 
กำหนดรหัสผ่าน root -e MYSQL_DATABASE=wordpress_db สร้างฐานข้อมูลชื่อ wordpress_db -e MYSQL_USER=wordpress สร้างผู้ใช้ชื่อ wordpress -e MYSQL_PASSWORD=wordpress 
กำหนดรหัสผ่านให้ผู้ใช้ wordpress -d mysql:5.7 รัน Image mysql:5.7 ในโหมด Background

# 2. รัน phpMyAdmin (พอร์ต 8888, เชื่อม MySQL อัตโนมัติในวงเดียวกัน)
docker run --name pma --network wordpress -p 8888:80 -e PMA_ARBITRARY=1 -d phpmyadmin/phpmyadmin

//คำอธิบายคำสั่ง --name pma ตั้งชื่อ Container ว่า pma --network wordpress เชื่อม Container เข้ากับ Network ที่สร้างไว้
 -p 8888:80 เชื่อมพอร์ต 8888 ของเครื่องเข้ากับพอร์ต 80 ของ Container -e PMA_ARBITRARY=1 อนุญาตให้เชื่อมต่อกับฐานข้อมูลใดก็ได้ในเครือข่ายเดียวกัน -d phpmyadmin/phpmyadmin รัน Image phpmyadmin/phpmyadmin ในโหมด Background

# 3. รัน WordPress (พอร์ต 888, เชื่อมฐานข้อมูล MySQL)
docker run -d --name wordpress --network wordpress -p 888:80 -e WORDPRESS_DB_HOST=mysql -e WORDPRESS_DB_USER=wordpress -e WORDPRESS_DB_PASSWORD=wordpress -e WORDPRESS_DB_NAME=wordpress_db wordpress

join network 

docker network connect wordpress <container_id> //เชื่อม Container ที่รันอยู่แล้วเข้ากับ Network ที่สร้างไว้
docker network connect wordpress mysql //เชื่อม Container mysql เข้ากับ Network wordpress
docker network connect wordpress pma //เชื่อม Container phpMyAdmin เข้ากับ Network wordpress
docker network disconnect wordpress <container_id> //ตัดการเชื่อมต่อ Container ออกจาก Network
**show network
docker network inspect wordpress //ดูรายละเอียดของ Network wordpress ว่ามี Container อะไรเชื่อมอยู่บ้าง